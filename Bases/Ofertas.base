filters:
  and:
    - note.tipo == "oferta"
formulas:
  score: (note.s_lucro * 35 + note.s_replica * 30 + note.s_ticket * 20 + note.s_saturacao * 15) / 100
  movimento: if(note.criativos_delta > 0, "sobe +" + note.criativos_delta, if(note.criativos_delta < 0, "cai " + note.criativos_delta, "estavel"))
  visto: date(note.visto_ultimo).relative()
  decisao: if((note.s_lucro * 35 + note.s_replica * 30 + note.s_ticket * 20 + note.s_saturacao * 15) / 100 >= 7.5 && note.s_replica >= 7, "REPLICAR", if((note.s_lucro * 35 + note.s_replica * 30 + note.s_ticket * 20 + note.s_saturacao * 15) / 100 >= 6, "observar", "descartar"))
properties:
  file.name:
    displayName: Oferta
  formula.score:
    displayName: Score
  formula.decisao:
    displayName: Decisao
  formula.movimento:
    displayName: Criativos
  formula.visto:
    displayName: Visto
  note.nicho:
    displayName: Nicho
  note.ticket_medio_est:
    displayName: Ticket med
  note.dias_no_ar:
    displayName: Dias no ar
  note.status:
    displayName: Status
  note.s_lucro:
    displayName: Lucro
  note.s_replica:
    displayName: Replica
  note.s_ticket:
    displayName: Ticket
  note.s_saturacao:
    displayName: Espaco
views:
  - type: table
    name: Ranking geral
    order:
      - file.name
      - formula.score
      - formula.decisao
      - nicho
      - ticket_medio_est
      - dias_no_ar
      - formula.movimento
      - status
      - formula.visto
    sort:
      - property: formula.score
        direction: DESC
    summaries:
      formula.score: Average
      ticket_medio_est: Average
  - type: table
    name: Por nicho
    groupBy:
      property: nicho
      direction: ASC
    order:
      - file.name
      - formula.score
      - ticket_medio_est
      - s_saturacao
      - status
    sort:
      - property: formula.score
        direction: DESC
    summaries:
      formula.score: Average
  - type: cards
    name: Radar visual
    order:
      - file.name
      - formula.score
      - nicho
      - formula.movimento
    sort:
      - property: formula.score
        direction: DESC
