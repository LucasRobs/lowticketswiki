filters:
  and:
    - note.tipo == "observacao"
formulas:
  quando: date(note.data).relative()
properties:
  note.slug:
    displayName: Oferta
  note.criativos_ativos:
    displayName: Criativos
  note.dias_no_ar:
    displayName: Dias no ar
  note.ticket_frente:
    displayName: Ticket
  note.angulo_novo:
    displayName: Angulo novo
  formula.quando:
    displayName: Quando
views:
  - type: table
    name: Serie temporal
    order:
      - data
      - slug
      - criativos_ativos
      - dias_no_ar
      - ticket_frente
      - preco_mudou
      - angulo_novo
    sort:
      - property: data
        direction: DESC
    limit: 500
  - type: table
    name: Por oferta
    groupBy:
      property: slug
      direction: ASC
    order:
      - data
      - criativos_ativos
      - ticket_frente
      - angulo_novo
    sort:
      - property: data
        direction: DESC
  - type: table
    name: Mudancas de preco
    filters:
      and:
        - note.preco_mudou == true
    order:
      - data
      - slug
      - ticket_frente
    sort:
      - property: data
        direction: DESC
